load("@buildifier_prebuilt//:rules.bzl", "buildifier")
load("@gazelle//:def.bzl", "gazelle")

# bazel run //:gazelle
# XXX: edit importpath
# gazelle:prefix github.com/filmil/bazel-registry
gazelle(name = "gazelle")

# Buildifier for the registry's own Bazel files. Both targets skip
# modules/: a published version must never change. Each version's
# MODULE.bazel and source.json are pinned by the registry's hashes, and
# source.json holds a hash of each overlay file, so a reformatted file
# breaks every consumer of that version (issue 896).
#
# These targets ignore arguments after `--`: their mode and file set are
# fixed here. `bazel run //:buildifier -- -mode=check` still formats.
#
# Formats in place:
#   bazel run //:buildifier
buildifier(
    name = "buildifier",
    exclude_patterns = ["./modules/*"],
    lint_mode = "warn",
)

# Reports formatting and lint findings and changes nothing:
#   bazel run //:buildifier.check
buildifier(
    name = "buildifier.check",
    exclude_patterns = ["./modules/*"],
    lint_mode = "warn",
    mode = "check",
)

# To check only the files of a new entry under modules/, run the binary
# itself with absolute paths (`bazel run` changes the working directory):
#   bazel run @buildifier_prebuilt//:buildifier -- -mode=check -lint=warn \
#     "$PWD"/modules/<name>/<version>/MODULE.bazel \
#     "$PWD"/modules/<name>/<version>/overlay/BUILD.bazel
