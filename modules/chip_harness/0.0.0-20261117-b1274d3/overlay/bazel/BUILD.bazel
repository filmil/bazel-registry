load("@rules_python//python:py_binary.bzl", "py_binary")
load(":dot_s8.bzl", "opt_tool")

package(default_visibility = ["//visibility:public"])

exports_files(["gate_main.cc"])

# The steps of the flow; see stage.py and dot_s8.bzl.
py_binary(
    name = "stage",
    srcs = ["stage.py"],
)

# The tools of the flow, built with -c opt. See opt_tool.
[opt_tool(
    name = name,
    actual = actual,
) for name, actual in [
    ("iverilog", "@iverilog//:iverilog"),
    ("ivl_base", "@iverilog//:ivl_base"),
    ("vvp", "@iverilog//:vvp"),
    ("verilator", "@verilator//:verilator"),
    ("yosys", "@yosys//:yosys"),
    ("sta", "@opensta//:sta"),
]]
