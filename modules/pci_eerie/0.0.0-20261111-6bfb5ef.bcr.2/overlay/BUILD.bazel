# Bazel overlay for https://github.com/regymm/pci_eerie.
# The upstream sources are unchanged. These targets name them for Bazel users.
# Every file is listed by name: the build fails if a listed file is missing.
#
# The upstream archive has no ext/pcie_7x: the scripts and file lists that
# name $PCIE_7X need it set to the sources of @pcie_7x.

package(default_visibility = ["//visibility:private"])

# The license and the synthesis files, one file at a time.
# A synthesis build picks one top and one board's .xdc files.
exports_files(
    [
        "LICENSE",
        "syn/eerie_host_app.v",
        "syn/eerie_host_rp.v",
        "syn/oxc_pcie_bram_7x.v",
        "syn/top_ac7100b_x4.v",
        "syn/top_ypcb_k480t.v",
        "syn/top_ypcb_k480t_rp.v",
        "syn/ac7100b_pins.xdc",
        "syn/ac7100b_x4_pins.xdc",
        "syn/ac7100b_x4_timing.xdc",
        "syn/hvs_k70t_pins.xdc",
        "syn/pci_eerie_timing.xdc",
        "syn/ypcb_k480t_pins.xdc",
        "syn/ypcb_k480t_rp.xdc",
        "syn/ypcb_k480t_rp_pzssd.xdc",
        "syn/vivado_impl.tcl",
    ],
    visibility = ["//visibility:public"],
)

# The core and testbench files, one file at a time, for builds that need
# only part of the core, such as the multi-lane PHY unit test.
exports_files(
    [
        "rtl/eerie_async_fifo.v",
        "rtl/eerie_cfg.v",
        "rtl/eerie_dll.v",
        "rtl/eerie_funcs.vh",
        "rtl/eerie_ltssm.v",
        "rtl/eerie_pl_deskew.v",
        "rtl/eerie_pl_rx.v",
        "rtl/eerie_pl_rx_ml.v",
        "rtl/eerie_pl_tx.v",
        "rtl/eerie_pl_tx_ml.v",
        "rtl/eerie_sync.v",
        "rtl/eerie_tl_rx.v",
        "rtl/eerie_tl_tx.v",
        "rtl/pci_eerie.v",
        "rtl/pci_eerie_params.vh",
        "rtl/pci_eerie_ports.vh",
        "tb/board.v",
        "tb/eerie_paths.vh",
        "tb/eerie_tb_app.v",
        "tb/eerie_tb_ep.v",
        "tb/eerie_tb_ep_ml.v",
        "tb/eerie_tests.vh",
        "tb/host_tb.v",
        "tb/pci_exp_usrapp_tx.v",
        "tb/pipe_mon.v",
        "tb/rp_mon.v",
        "tb/unit/ml_phy_tb.v",
    ],
    visibility = ["//visibility:public"],
)

# The soft core sources, in the compile order of rtl/files.f.
filegroup(
    name = "rtl_srcs",
    srcs = [
        # do not sort: compile order
        "rtl/eerie_sync.v",
        "rtl/eerie_async_fifo.v",
        "rtl/eerie_pl_rx.v",
        "rtl/eerie_pl_rx_ml.v",
        "rtl/eerie_pl_deskew.v",
        "rtl/eerie_pl_tx.v",
        "rtl/eerie_pl_tx_ml.v",
        "rtl/eerie_ltssm.v",
        "rtl/eerie_dll.v",
        "rtl/eerie_cfg.v",
        "rtl/eerie_tl_rx.v",
        "rtl/eerie_tl_tx.v",
        "rtl/pci_eerie.v",
    ],
    visibility = ["//visibility:public"],
)

# The files that rtl/ sources include. Put rtl/ on the include path.
filegroup(
    name = "rtl_hdrs",
    srcs = [
        "rtl/eerie_funcs.vh",
        "rtl/pci_eerie_params.vh",
        "rtl/pci_eerie_ports.vh",
    ],
    visibility = ["//visibility:public"],
)

# The sources and the headers together.
filegroup(
    name = "rtl",
    srcs = [
        ":rtl_hdrs",
        ":rtl_srcs",
    ],
    visibility = ["//visibility:public"],
)

# The drop-in replacement for pcie_7x's src/pcie_block.v.
# It instantiates the soft core in place of the PCIE_2_1 hard block.
filegroup(
    name = "integration",
    srcs = [
        "integration/pcie_block.v",
    ],
    visibility = ["//visibility:public"],
)

# pcie_7x with the soft core in place of the hard block: the sources the
# upstream "eerie" simulation and synthesis configurations compile, and
# the rtl/ headers they include. Put rtl/ on the include path.
filegroup(
    name = "pcie_7x_eerie",
    srcs = [
        ":pcie_7x_eerie_srcs",
        ":rtl_hdrs",
    ],
    visibility = ["//visibility:public"],
)

# The same sources without the headers, for rules that take headers apart.
filegroup(
    name = "pcie_7x_eerie_srcs",
    srcs = [
        ":integration",
        ":rtl_srcs",
        "@pcie_7x//:src_except_pcie_block",
    ],
    visibility = ["//visibility:public"],
)

# Testbench sources, the multi-lane PHY unit test among them.
filegroup(
    name = "tb_srcs",
    srcs = [
        "tb/board.v",
        "tb/eerie_tb_app.v",
        "tb/eerie_tb_ep.v",
        "tb/eerie_tb_ep_ml.v",
        "tb/host_tb.v",
        "tb/pci_exp_usrapp_tx.v",
        "tb/pipe_mon.v",
        "tb/rp_mon.v",
        "tb/unit/ml_phy_tb.v",
    ],
    visibility = ["//visibility:public"],
)

# The files that the testbenches include. Put tb/ on the include path.
filegroup(
    name = "tb_hdrs",
    srcs = [
        "tb/eerie_paths.vh",
        "tb/eerie_tests.vh",
    ],
    visibility = ["//visibility:public"],
)

# The testbench sources and headers together.
filegroup(
    name = "tb",
    srcs = [
        ":tb_hdrs",
        ":tb_srcs",
    ],
    visibility = ["//visibility:public"],
)

# The xsim regression file lists. They name files under $PCIE_7X and
# $PCIE_EX, the Vivado example design that is not in the archive.
filegroup(
    name = "sim_filelists",
    srcs = [
        "sim/files_common.f",
    ],
    visibility = ["//visibility:public"],
)

# Decoded traces and config dumps of the PCIE_2_1 reference runs. Upstream
# compares some runs against them by hand (README, sim/ref/); the xsim
# regression in the test module does not use them.
filegroup(
    name = "sim_refs",
    srcs = [
        "sim/ref/baseline_cfg_dump.txt",
        "sim/ref/baseline_gen1_decode.txt",
        "sim/ref/baseline_gen2_decode.txt",
        "sim/ref/eerie_gen1_decode.txt",
        "sim/ref/eerie_gen2_decode.txt",
        "sim/ref/rp_cfg_dump_hard.txt",
    ],
    visibility = ["//visibility:public"],
)

# Synthesis tops and their wrappers, all together.
filegroup(
    name = "syn_srcs",
    srcs = [
        "syn/eerie_host_app.v",
        "syn/eerie_host_rp.v",
        "syn/oxc_pcie_bram_7x.v",
        "syn/top_ac7100b_x4.v",
        "syn/top_ypcb_k480t.v",
        "syn/top_ypcb_k480t_rp.v",
    ],
    visibility = ["//visibility:public"],
)

# All synthesis constraint files, all together.
filegroup(
    name = "syn_xdc",
    srcs = [
        "syn/ac7100b_pins.xdc",
        "syn/ac7100b_x4_pins.xdc",
        "syn/ac7100b_x4_timing.xdc",
        "syn/hvs_k70t_pins.xdc",
        "syn/pci_eerie_timing.xdc",
        "syn/ypcb_k480t_pins.xdc",
        "syn/ypcb_k480t_rp.xdc",
        "syn/ypcb_k480t_rp_pzssd.xdc",
    ],
    visibility = ["//visibility:public"],
)

# The Vivado implementation script.
filegroup(
    name = "syn_tcl",
    srcs = [
        "syn/vivado_impl.tcl",
    ],
    visibility = ["//visibility:public"],
)
