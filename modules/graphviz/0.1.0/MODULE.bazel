module(
    name = "graphviz",
    version = "0.1.0",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "zlib", version = "1.3.2")
bazel_dep(name = "rules_shell", version = "0.8.0")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2", dev_dependency = True)

# The zig-based hermetic C++ toolchain is for *this* repository's own builds
# only, hence dev_dependency throughout.
#
# hermetic_cc_toolchain's module extension creates its repositories only for the
# root module ("if mod.is_root:" in toolchain/ext.bzl). When graphviz is
# consumed as a dependency no zig_sdk repo is generated, so a non-dev
# use_repo(toolchains, "zig_sdk") is invalid and every consumer fails with:
#
#   ERROR: module extension ...%toolchains does not generate repository
#   "zig_sdk", yet it is imported as "zig_sdk"
#
# Marking the block dev_dependency drops it for consumers, who build graphviz
# with their own C++ toolchain. That is also the right default for a library
# module: register_toolchains affects the entire toolchain resolution of any
# project that depends on us, which is the root module's decision to make.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0", dev_dependency = True)

toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
    dev_dependency = True,
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "src",
    build_file = "//:src.BUILD.bazel",
    integrity = "sha256-rT9lTV1OHR5b5khvrTEG3FTo0yD7eIn3XZ05JT0uPYc=",
    patch_strip = 1,
    patches = [
    ],
    strip_prefix = "graphviz-14.0.0",
    urls = [
        "https://gitlab.com/api/v4/projects/4207231/packages/generic/graphviz-releases/14.0.0/graphviz-14.0.0.tar.gz",
    ],
)



bazel_dep(name = "protobuf", version = "35.1")
