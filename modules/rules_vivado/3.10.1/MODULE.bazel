module(
    name = "rules_vivado",
    version = "3.10.1",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "bazel_lib", version = "3.3.1")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.0", dev_dependency = True)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")
bazel_dep(name = "fshlib", version = "0.2.7")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "gotopt2", version = "2.8.3")
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_bid", version = "2.3.1")
bazel_dep(name = "rules_go", version = "0.61.1", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "stardoc", version = "0.8.1")

register_toolchains("//toolchains:all")

# Hermetic Vivado installation support. The extension always creates the
# @vivado_hermetic repository; without a `vivado.install(...)` tag in the
# root module it is a stub that fails with setup instructions, and it is
# only ever fetched under --//:vivado_mode=hermetic.
vivado = use_extension("//:extensions.bzl", "vivado")
use_repo(vivado, "vivado_hermetic")

# Maintainer-local hermetic install used to exercise hermetic mode during
# development. Ignored unless this module is the root module; the repository
# is only fetched under --//:vivado_mode=hermetic. Adjust the URL to where
# your installer archive lives.
vivado_dev = use_extension("//:extensions.bzl", "vivado", dev_dependency = True)
vivado_dev.install(
    modules = ["Artix-7"],
    sha256 = "cd1021b04166e43c0d59cbbded7b1687dda5e9dad890b82492f872b2fe32a725",
    urls = ["file:///home/filmil/Downloads/FPGAs_AdaptiveSoCs_Unified_SDI_2025.2_1114_2157_1.tar"],
)
