load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Registry overlay files arrive without the executable bit, so each test
# script is copied into an executable one first.
[genrule(
    name = name + "_sh",
    srcs = [name + ".sh"],
    outs = [name + "_exe.sh"],
    cmd = "cp $< $@ && chmod +x $@",
    executable = True,
) for name in [
    "compile_run_test",
    "exec_check",
    "hermetic_test",
    "run_test",
    "version_test",
]]

sh_test(
    name = "counter_test",
    srcs = [":run_test_sh"],
    args = [
        "$(rootpath @xezim)",
        "waves",
        "count=10",
        "$(rootpath counter.sv)",
    ],
    data = [
        "counter.sv",
        "@xezim",
    ],
)

sh_test(
    name = "fatal_test",
    srcs = [":run_test_sh"],
    args = [
        "$(rootpath @xezim)",
        "fatal",
        "'** Fatal: expected failure'",
        "$(rootpath fatal.sv)",
    ],
    data = [
        "fatal.sv",
        "@xezim",
    ],
)

sh_test(
    name = "version_test",
    srcs = [":version_test_sh"],
    args = ["$(rootpath @xezim)"],
    data = ["@xezim"],
)

sh_test(
    name = "compile_run_test",
    srcs = [":compile_run_test_sh"],
    args = [
        "$(rootpath @xezim)",
        "$(rootpath counter.sv)",
        "count=10",
    ],
    data = [
        "counter.sv",
        "@xezim",
    ],
)

cc_binary(
    name = "dpi.so",
    srcs = ["dpi.c"],
    linkshared = True,
    deps = ["@xezim//:headers"],
)

sh_test(
    name = "dpi_test",
    srcs = [":run_test_sh"],
    args = [
        "$(rootpath @xezim)",
        "pass",
        "dpi_add=42",
        "--dpi-lib",
        "$(rootpath :dpi.so)",
        "$(rootpath dpi.sv)",
    ],
    data = [
        "dpi.sv",
        ":dpi.so",
        "@xezim",
    ],
)

cc_binary(
    name = "vpi.so",
    srcs = ["vpi.c"],
    linkshared = True,
    deps = ["@xezim//:headers"],
)

sh_test(
    name = "vpi_test",
    srcs = [":run_test_sh"],
    args = [
        "$(rootpath @xezim)",
        "pass",
        "vpi_hello=42",
        "--vpi-lib",
        "$(rootpath :vpi.so)",
        "$(rootpath counter.sv)",
    ],
    data = [
        "counter.sv",
        ":vpi.so",
        "@xezim",
    ],
)

# xezim as a build tool, in the exec configuration.
genrule(
    name = "counter_out",
    srcs = ["counter.sv"],
    outs = ["counter_out.txt"],
    cmd = "$(execpath @xezim) --no-cache $< > $@",
    tools = ["@xezim"],
)

sh_test(
    name = "exec_test",
    srcs = [":exec_check_sh"],
    args = ["$(rootpath :counter_out)"],
    data = [":counter_out"],
)

sh_test(
    name = "hermetic_test",
    srcs = [":hermetic_test_sh"],
    args = ["$(rootpath @xezim)"],
    data = ["@xezim"],
)
